# Database (SQLite - just a file path)
DATABASE_URL=file:./data/tennis.db

# Cron job protection
CRON_SECRET=cron-secret

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxx

# Email via Resend (HTTP API - works on Railway/cloud)
# Sign up at https://resend.com (free: 3000 emails/month)
# IMPORTANT: EMAIL_FROM must use a domain verified in your Resend account
# If you haven't verified a domain, Resend will reject emails
# Example: EMAIL_FROM='Your App Name <noreply@yourdomain.com>'
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Your App Name <noreply@yourdomain.com>

# App URL (public domain; base for notification links, magic-link emails, and
# the mobile app's deep-link bridge). Production: https://timefor10s.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (NextAuth v5)
# AUTH_SECRET also signs the mobile app's bearer tokens (/api/auth/mobile/*)
AUTH_SECRET=some-random-string
# AUTH_URL / NEXTAUTH_URL are required in production - set to the public domain.
# All three (AUTH_URL, NEXT_PUBLIC_APP_URL, NEXTAUTH_URL) should match.
# AUTH_URL=https://timefor10s.com
# NEXTAUTH_URL=https://timefor10s.com

# Mobile app (Expo) push notifications
# Optional Expo access token for enhanced push security / higher limits
# EXPO_ACCESS_TOKEN=

# Scraper-health monitoring (off-the-shelf)
# Healthchecks.io dead-man's-switch URL: success pings keep it green, a missed
# ping or a /fail ping (sent on silent parser breakage) triggers its alert.
# SCRAPE_HEALTHCHECK_URL=https://hc-ping.com/your-uuid
# Admin address that receives scraper-health alert emails
# ADMIN_EMAIL=you@example.com
# Optional: flag a run as unhealthy if it averaged fewer than N slots per
# scraped target (0 = only flag zero-slot runs). Tighten to catch partial breaks.
# SCRAPE_MIN_SLOTS_PER_TARGET=0
# Optional: min hours between health alert emails (default 1)
# SCRAPE_HEALTH_COOLDOWN_HOURS=1