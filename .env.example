# Database (SQLite - just a file path)
DATABASE_URL=file:./data/tennis.db

# Cron job protection
CRON_SECRET=cron-secret

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxx

# Email via Resend (HTTP API - works on Railway/cloud)
# Sign up at https://resend.com (free: 3000 emails/month)
# IMPORTANT: EMAIL_FROM must use a domain verified in your Resend account
# If you haven't verified a domain, Resend will reject emails
# Example: EMAIL_FROM='Your App Name <noreply@yourdomain.com>'
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Your App Name <noreply@yourdomain.com>

# App URL (for links in notifications)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (NextAuth v5)
AUTH_SECRET=some-random-string
# AUTH_URL is required in production - set to your app's public URL
# AUTH_URL=https://your-app.railway.app

# --- Feed-primary ingestion ---
# The cron endpoint runs feed-primary ingestion: OpenActive feed head-poll (Clock 1,
# every tick) → confirm-on-notify → ClubSpark poll → periodic full sweep. The blind
# HTML scraper and the watch-targeted reconcile clock are retired. All optional,
# shown with defaults:
# Sweep cadence (hours) — the ONE Courtside HTML knob. The sweep is fixed-cost
# (venues × window venue-days/run, independent of watcher count), so this is a pure
# latency/bandwidth dial: sweep interval = worst-case false-negative alert latency.
# SWEEP_INTERVAL_HOURS=2
# Confirm-on-notify: scrape a watched feed flip's venue-day before alerting to drop
# feed false-positives. Set to off/false/0 to disable (e.g. to save proxy bandwidth
# in staging); it already degrades to direct-notify when the proxy is off.
# CONFIRM_ON_NOTIFY=on
# Max venue-days one confirm pass may scrape (safety valve against a feed dump).
# CONFIRM_MAX_VENUE_DAYS=20
# How often (hours) to refresh venue/court metadata from the facility feed.
# FACILITY_REFRESH_HOURS=6
# Days ahead to ingest/sweep.
# SCRAPE_DAYS=8