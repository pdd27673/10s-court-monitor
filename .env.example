# Database — Railway Postgres (or local Postgres)
# On Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@localhost:5432/tennis

# Cron job protection (Authorization: Bearer … on /api/cron/scrape)
CRON_SECRET=cron-secret

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxx
# Optional: shared secret verified by /api/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=

# Email via Resend (HTTP API — works on Railway where SMTP is blocked)
# Sign up at https://resend.com (free: 3000 emails/month)
# EMAIL_FROM must use a domain verified in your Resend account
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Your App Name <noreply@yourdomain.com>
# Optional: admin recipient for ops emails
# ADMIN_EMAIL=you@example.com

# App URL (for links in notifications / sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Prefer AUTH_URL in production (Auth.js). Some email/sitemap paths still
# fall back to NEXTAUTH_URL — set both to the same public origin if unsure.
# AUTH_URL=https://your-app.railway.app
# NEXTAUTH_URL=https://your-app.railway.app

# Auth (NextAuth / Auth.js v5)
AUTH_SECRET=some-random-string

# --- Feed-primary ingestion (3-clock hybrid) ---
# Cron runs Clock 1 head-poll + Clock 2b watch-reconcile + Clock 3 daily sweep
# (+ ClubSpark poll). Blind HTML scrape is retired. Optional tunables:
# RECONCILE_MAX_PAGES=40
# RECONCILE_INTERVAL_MIN=15
# SWEEP_INTERVAL_HOURS=24
# FACILITY_REFRESH_HOURS=6
# CLUBSPARK_INTERVAL_MIN=5
# SCRAPE_DAYS=8
# CLEANUP_DAYS=7

# Optional residential proxy (ClubSpark/Courtside HTML backstop only)
# WEBSHARE_PROXY_HOST=
# WEBSHARE_PROXY_PORT=80
# WEBSHARE_USERNAME=
# WEBSHARE_PASSWORD=
