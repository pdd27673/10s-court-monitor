{
  "name": "10s",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run db:migrate",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:sync": "tsx scripts/db-migrate.ts --push",
    "db:normalize-emails": "tsx scripts/normalize-emails.ts",
    "db:migrate-watches": "tsx scripts/migrate-watches-to-days.ts",
    "maintain": "tsx scripts/maintain.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pdd27673/10s-contract": "file:packages/contract",
    "@auth/drizzle-adapter": "^1.11.2",
    "@tailwindcss/postcss": "^4.3.2",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "got": "^15.1.0",
    "https-proxy-agent": "^9.1.0",
    "jose": "^6.2.3",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.30",
    "node-fetch": "^3.3.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "^6.17.2",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "user-agents": "^2.1.117"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19",
    "@types/user-agents": "^1.0.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.10",
    "tsx": "^4.23.0",
    "vitest": "^4.1.10"
  }
