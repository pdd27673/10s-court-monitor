{
  "name": "10s",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/lib/ingest/worker.ts",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:sync": "tsx scripts/db-migrate.ts --push",
    "db:normalize-emails": "tsx scripts/normalize-emails.ts",
    "db:migrate-watches": "tsx scripts/migrate-watches-to-days.ts",
    "db:migrate-daytimes": "tsx scripts/migrate-daytimes-to-hhmm.ts",
    "db:migrate-data": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:seed-venues": "tsx scripts/seed-venue-metadata.ts",
    "maintain": "tsx scripts/maintain.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:contract": "tsc --noEmit -p packages/contract",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@pdd27673/10s-contract": "file:packages/contract",
    "@tailwindcss/postcss": "^4",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.4",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "got": "^14.6.6",
    "https-proxy-agent": "^7.0.6",
    "jose": "^6.1.3",
    "leaflet": "^1.9.4",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "node-fetch": "^3.3.2",
    "pg": "^8.13.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "resend": "^6.8.0",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "user-agents": "^1.1.669"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19",
    "@types/user-agents": "^1.0.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tsx": "^4.21.0",
    "vitest": "^4.1.10"
  }
}
